# Image tag (an X.Y.Z backend version, X.Y.Z-YYYYMMDD, or latest).
TODEX_CONTAINER_TAG=latest

# Absolute host directory to work in. It is mounted at the same path inside
# the container and becomes the backend's workspace root.
TODEX_WORKDIR=/home/me/projects
# Windows hosts cannot mount at the same path. Mount under /workspace instead
# and tell the backend how the paths correspond, for example:
#   TODEX_WORKDIR=C:\Users\me\code
#   TODEX_WORKDIR_TARGET=/workspace/code
#   TODEX_PATH_MAPPINGS='[{"hostPath":"C:\\Users\\me\\code","backendPath":"/workspace/code"}]'
TODEX_WORKDIR_TARGET=
# Host-to-container path mapping as JSON. Keep it in step with the two values
# above; Desktop uses it to open files locally and to map "Choose locally".
TODEX_PATH_MAPPINGS='[{"hostPath":"/home/me/projects","backendPath":"/home/me/projects"}]'

# Run the container user with your host IDs so mounted files keep your
# ownership (`id -u` / `id -g`). Must not be 0.
TODEX_UID=1000
TODEX_GID=1000

# Published address. Keep 127.0.0.1 unless other machines must connect; they
# still need to pair, and traffic stays encrypted.
TODEX_LISTEN=127.0.0.1
TODEX_PORT=7345
# Host name shown in the backend's connect hints.
TODEX_ADVERTISE_HOST=127.0.0.1

# CLIs installed into the home volume on first start (comma-separated TodeX
# provider ids: claude-code, grok-build, devin, antigravity, deepseek-harness).
# Leave empty to install nothing.
TODEX_EXTRA_AGENTS=claude-code

# Optional git identity, written once to ~/.gitconfig in the home volume.
TODEX_GIT_NAME=
TODEX_GIT_EMAIL=
